{
  "manifest_version": 3,
  "name": "GlassDesk",
  "version": "0.1.1",
  "description": "深色 macOS 风格新标签页：把书签变成一张可以左右切换的桌面。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "favicon"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116"
}
