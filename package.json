{
  "name": "glassdesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A dark macOS-style new tab that turns bookmarks into switchable desktops.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e:ext": "npm run build && cross-env GLASSDESK_EXT=1 playwright test tests/e2e/extension.spec.ts",
    "verify": "npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junglecola001/glassdesk.git"
  },
  "homepage": "https://github.com/junglecola001/glassdesk#readme"
}
